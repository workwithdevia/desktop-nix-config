{
  "title": "Vimium Keybinds",
  "provider": "vimium",
  "binds": {
    "Tabs & Windows": [
      {
        "key": "t",
        "desc": "Open new tab"
      },
      {
        "key": "x",
        "desc": "Close current tab"
      },
      {
        "key": "X",
        "desc": "Reopen closed tab"
      },
      {
        "key": "K / gt",
        "desc": "Next tab"
      },
      {
        "key": "J / gT",
        "desc": "Previous tab"
      },
      {
        "key": "W",
        "desc": "Move current tab to new window"
      }
    ],
    "Navigation & Page": [
      {
        "key": "r",
        "desc": "Reload page"
      },
      {
        "key": "R",
        "desc": "Hard reload page"
      },
      {
        "key": "ge",
        "desc": "Edit current URL"
      },
      {
        "key": "H / L",
        "desc": "Back / Forward in history"
      }
    ],
    "Hints & Search": [
      {
        "key": "f",
        "desc": "Open link in current tab"
      },
      {
        "key": "F",
        "desc": "Open link in new tab"
      },
      {
        "key": "o",
        "desc": "Open URL, bookmark, or history search"
      },
      {
        "key": "/",
        "desc": "Search in page"
      }
    ]
  }
}